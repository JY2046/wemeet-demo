{
  "functions": {
    "api/transcribe.py": {
      "maxDuration": 60
    },
    "api/parse_order.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/transcribe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/parse_order",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
